# =========================================================================
# direnv — auto-loads the flake devShell on cd
# =========================================================================
# Requires direnv + nix-direnv (omni-nix → home/devshell.nix). After editing
# flake.nix OR this file:  direnv allow
use flake

# Auto-activate a LOCAL .venv if present. The devShell already provides the
# uv2nix venv (from pyproject.toml/uv.lock); create a local one only for ad-hoc
# deps:   uv sync
if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
fi
